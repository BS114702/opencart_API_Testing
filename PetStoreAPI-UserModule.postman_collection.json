      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const randomnum = Math.floor((Math.random() * 100+1));\r\nvar randomstr = \"john\" + Math.random().toString(36).substring(2);\r\n\r\npm.environment.set(\"id\", randomnum);\r\npm.collectionVariables.set(\"username\", randomstr);\r\npm.collectionVariables.set(\"email\", randomstr + \"@gmail.com\");\r\npm.collectionVariables.set(\"password\", randomstr);\r\npm.collectionVariables.set(\"phone\", \"1234567890\");\r\npm.collectionVariables.set(\"userStatus\", \"0\");\r\npm.collectionVariables.set(\"firstName\", randomstr);\r\npm.collectionVariables.set(\"lastName\", randomstr);\r\n\r\nconsole.log(randomnum);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"check status code\", function(){\r\n    pm.response.to.have.status(200);\r\n});"
